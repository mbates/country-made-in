{
  "name": "country-made-in",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome Extension (Manifest V3) showing product origin transparency on Amazon",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "generate:countries": "node scripts/generate-countries.mjs",
    "lint": "eslint src/ test/ scripts/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/ test/ scripts/ *.config.* tsconfig*.json .prettierrc",
    "format:check": "prettier --check src/ test/ scripts/ *.config.* tsconfig*.json .prettierrc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbates/country-made-in.git"
  },
  "license": "MIT",
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.2.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
